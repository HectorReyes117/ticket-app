{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "SUPABASE_DB"
  },
  "JwtSettings": {
    "Secret": "JWT_SECRET",
    "Issuer": "TicketAppApi",
    "Audience": "TicketAppClient",
    "DurationInMinutes": 480
  },
  "SmtpSettings": {
    "Host": "SMTP_HOST",
    "Port": 587,
    "UseSsl": false,
    "UserName": "SMTP_USERNAME",
    "Password": "SMTP_PASSWORD",
    "FromEmail": "SMTP_FROM_EMAIL",
    "FromName": "TicketApp Soporte"
  },
  "FrontendUrl": "http://localhost:5173"
}
